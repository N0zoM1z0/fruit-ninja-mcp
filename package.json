{
  "name": "fruit-ninja-self-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Realtime Fruit Ninja: screenshot GUI versus agent-built MCP, with a black-box builder sandbox (based on N0zoM1z0/fruit-ninja-mcp)",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "fruit-ninja-mcp": "dist/cli.js"
  },
  "scripts": {
    "setup": "tsx scripts/install-game.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts serve",
    "play": "tsx scripts/play.ts",
    "trial": "tsx scripts/trial.ts",
    "compare": "tsx scripts/compare.ts",
    "validate:optimization": "tsx scripts/validate-optimization.ts",
    "export:video": "tsx scripts/export-video.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "format": "prettier --write src scripts tests dev-fixtures sandbox/public results recordings README.md RESULTS.md REALTIME-PROTOCOL.md OPTIMIZATION.md ARCHITECTURE.md NOTICE.md package.json tsconfig*.json",
    "format:check": "prettier --check src scripts tests dev-fixtures sandbox/public results recordings README.md RESULTS.md REALTIME-PROTOCOL.md OPTIMIZATION.md ARCHITECTURE.md NOTICE.md package.json tsconfig*.json",
    "package": "tsx scripts/package.ts",
    "builder": "tsx scripts/builder.ts",
    "preview": "tsx scripts/preview.ts",
    "test:unit": "node --import tsx --test tests/unit-*.test.ts",
    "pilot": "tsx scripts/pilot.ts",
    "windows:setup": "python3 native/setup.py",
    "windows:rea": "node native/investigate.mjs",
    "windows:serve": "node native/cli.mjs serve",
    "windows:gui": "node native/cli.mjs serve --interface gui",
    "windows:demo": "node native/demo.mjs",
    "test:windows": "node --test tests/native-*.test.mjs",
    "windows:compare": "node native/compare.mjs",
    "windows:compose": "node native/compose.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright-core": "1.64.1",
    "zod": "4.6.7",
    "acorn": "8.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
